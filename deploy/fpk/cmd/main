#!/bin/bash
# MediaTrack (mediary-scout) — fnOS 原生应用生命周期脚本
# 由飞牛应用中心调用：start / stop / status
#
# 布局说明：
#   fpk 的 app/server/（Next.js standalone 产物）随 app.tgz 解压到应用安装目录
#   target/（TRIM_APPDEST 即该目录），本脚本与 target 平级位于 cmd/ 下。
#   start 时 cd 到 server 根，执行 node apps/web/server.js（与 Dockerfile runner 一致）。

LOG_FILE="${TRIM_PKGVAR}/mediary.log"
PID_FILE="${TRIM_PKGVAR}/mediary.pid"

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

# ---- 定位 server 目录（standalone 产物根）----
if [ -n "${TRIM_APPDEST:-}" ] && [ -d "${TRIM_APPDEST}/server" ]; then
    SERVER_DIR="${TRIM_APPDEST}/server"
elif [ -d "${SCRIPT_DIR}/../target/server" ]; then
    SERVER_DIR="${SCRIPT_DIR}/../target/server"
elif [ -d "${SCRIPT_DIR}/../server" ]; then
    SERVER_DIR="${SCRIPT_DIR}/../server"
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') - server directory not found" >> "${LOG_FILE}"
    exit 1
fi

# ---- Node.js 24 运行时（manifest install_dep_apps=nodejs_v24 保证存在）----
if [ -x "/var/apps/nodejs_v24/target/bin/node" ]; then
    export PATH="/var/apps/nodejs_v24/target/bin:$PATH"
fi

# ---- 运行时环境变量 ----
# 对齐 docker-compose.yml 正式服务（SQLite 化：数据放 TRIM_PKGVAR，升级不丢）。
# 注意：MEDIA_TRACK_POSTGRES_URL 不设置；设置了 MEDIA_TRACK_SQLITE_PATH 即走 SQLite
# 仓库（见 apps/web/lib/workflow-runtime.ts getWorkflowRepository）。
export NODE_ENV=production
export HOSTNAME=0.0.0.0
export PORT="${TRIM_SERVICE_PORT:-3333}"          # manifest service_port=3333，避开 docker 3000 / preview 3100
export MEDIA_TRACK_SQLITE_PATH="${TRIM_PKGVAR}/mediary.db"
export MEDIA_TRACK_WORKFLOW_ADAPTER=pansou        # 官方源（so.252035.xyz），无需自建容器
export MEDIA_TRACK_SEARCH_PROVIDER=tmdb
export MEDIA_TRACK_AGENT_ADAPTER=vercel-ai        # pansou+115 必需，见 compose 注释
export MEDIA_TRACK_STORAGE_ADAPTER=115            # 对齐旧正式配置；可在下方按需修改
export MEDIA_TRACK_DEMO_SEED=0                    # 与 compose 一致：非演示环境也不种数据

# 未设置（对齐 compose 的缺省/可选行为）：
#   PANSOU_BASE_URL          —— 不设即用官方源默认值（设置页可改）
#   MEDIA_TRACK_ALLOWED_ORIGINS —— iframe 同源访问，无需跨域 server action
#   MEDIA_TRACK_AGENT_LOG    —— 可选，排障时再开
#   TUNNEL_TOKEN             —— Cloudflare Tunnel 可选，用户自行配置

CMD="cd \"${SERVER_DIR}\" && exec node apps/web/server.js"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting MediaTrack (server=${SERVER_DIR}, port=${PORT}) ..."
    bash -c "${CMD}" >> "${LOG_FILE}" 2>&1 &
    # bash -c 以 exec 替换自身，$! 即 node 进程 PID
    printf "%s" "$!" > "${PID_FILE}"
    return 0
}

stop_process() {
    log_msg "Stopping MediaTrack ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            # process not exist, delete pidfile
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed..."
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # process exist
    else
        return 1  # process not exist
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # Process is not running but pidfile exists - clean it up
            rm -f "${PID_FILE}"
        fi
    fi

    return 1
}

case $1 in
start)
    # run start command. exit 0 if success, exit 1 if failed
    start_process
    ;;
stop)
    # run stop command. exit 0 if success, exit 1 if failed
    stop_process
    ;;
status)
    # check application status command. exit 0 if running, exit 3 if not running
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
