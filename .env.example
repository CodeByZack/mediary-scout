# ═════════════════════════════════════════════════════════════════════════
# MediaTrack 环境变量 — 完整参考
# ═════════════════════════════════════════════════════════════════════════
# 用法：
#   cp .env.example .env  然后编辑 .env 填入你的配置。
# docker compose 部署多数项已自动注入（见 docker-compose.yml），无需手填。
# 非 compose 本机跑时才需手填。
#
# 优先级：设置页(DB) > .env 文件 > 代码默认值。
# ═════════════════════════════════════════════════════════════════════════

# ─── 核心配置 ────────────────────────────────────────────────────────────

# SQLite 数据库文件路径。compose 自动指向 /data/mediary.db。
# 非 compose 填绝对路径，如 /data/mediary.db 或 /home/user/mediary.db。
MEDIA_TRACK_SQLITE_PATH=

# Session 签名密钥。不填则自动生成（重启后旧 session 失效）。
# 生产环境建议设为固定长随机串：openssl rand -hex 32
MEDIA_TRACK_SESSION_SECRET=

# Cookie 的 Secure 标记。不设为按协议自动判定（HTTPS 加、HTTP 不加）。
#   "1" 强制开启  "0" 强制关闭  留空 自动
# MEDIA_TRACK_COOKIE_SECURE=

# Server Action 允许的跨域来源（逗号分隔）。反代/隧道下 CSRF 拦截时填。
# ⚠️ 构建时烘焙进产物，改后需 docker compose up -d --build
# MEDIA_TRACK_ALLOWED_ORIGINS=mediary.example.com

# 通知消息中的公开跳转 URL。不设则消息不带链接。
# MEDIA_TRACK_PUBLIC_BASE_URL=

# 设为 "0" 可禁用进程内 Worker（外部调度时使用）
# MEDIA_TRACK_INPROCESS_WORKER=0

# ─── 适配器模式 ─────────────────────────────────────────────────────────

# 存储后端：fake（默认，无副作用）/ 115（真实 115 网盘）
# 设为 "115" 时强制要求 MEDIA_TRACK_AGENT_ADAPTER=vercel-ai
MEDIA_TRACK_STORAGE_ADAPTER=fake

# 搜索适配器：fake（默认）/ pansou（真实 PanSou 搜索）
MEDIA_TRACK_WORKFLOW_ADAPTER=fake

# AI Agent 适配器：fake（默认）/ vercel-ai（真实 LLM）
# ⚠️ 有效值仅 "fake" 和 "vercel-ai"，"real" 是无效值（启动报错）
MEDIA_TRACK_AGENT_ADAPTER=fake

# 搜索数据源：demo（确定性演示数据）/ tmdb（真实 TMDB 搜索）
MEDIA_TRACK_SEARCH_PROVIDER=demo

# 默认网盘品牌（影响首次连接时的默认选择）
# MEDIA_TRACK_DEFAULT_STORAGE_BRAND=

# Demo 种子数据。"0" 禁用，"1" 启用（compose 默认 "0"）
MEDIA_TRACK_DEMO_SEED=1

# 搜索关键词附加的质量偏好
MEDIA_TRACK_DEFAULT_QUALITY=4K

# 默认 TV 存储目录 ID。留空让 Type 2 自动创建 "剧名 (年份)/Season N"
MEDIA_TRACK_DEFAULT_TV_STORAGE_DIRECTORY_ID=

# ─── 115 网盘 ───────────────────────────────────────────────────────────

# 115 认证 Cookie（真实 115 模式必填）
# ⚠️ 必须用双引号包裹（Cookie 含分号）
PAN115_COOKIE=""

# 开发/测试根目录 CID。生产模式推荐用 WRITE_SCOPE_CIDS 替代。
MEDIA_TRACK_115_TEST_ROOT_CID=

# 生产写权限 CID 列表（逗号分隔）。与 TEST_ROOT_CID 二选一。
MEDIA_TRACK_115_WRITE_SCOPE_CIDS=

# 受保护目录 CID 列表（只读，禁止写入，逗号分隔）
MEDIA_TRACK_115_PROTECTED_CIDS=

# 115 API 调用最小间隔（毫秒，默认 1200，防限流）
# MEDIA_TRACK_115_MIN_DELAY_MS=

# 单次操作最大 API 调用次数（默认 300）
# MEDIA_TRACK_115_MAX_API_CALLS=

# ─── 目录结构 ───────────────────────────────────────────────────────────

# 剧集目录父级 CID（新命名，推荐）
MEDIA_TRACK_TV_PARENT_CID=

# 动漫目录父级 CID（新命名，推荐）
MEDIA_TRACK_ANIME_PARENT_CID=

# 电影目录父级 CID（新命名，推荐）
MEDIA_TRACK_MOVIES_PARENT_CID=

# ─── 自定义目录名称 ───────────────────────────────────────────────────

# 自定义媒体库根目录名（影响所有网盘：115 / 夸克 / 光鸭）
# 默认 "Mediary Scout"。改名只影响之后新连接的盘，已连接的需重连生效。
# MEDIA_TRACK_LIBRARY_ROOT_DIR=我的影音库
# MEDIA_TRACK_LIBRARY_MOVIES_DIR=电影
# MEDIA_TRACK_LIBRARY_TV_DIR=剧集
# MEDIA_TRACK_LIBRARY_ANIME_DIR=番剧

# ─── AI 模型（LLM） ────────────────────────────────────────────────────

# 任意 OpenAI 兼容服务。必填：Base URL + 模型名；云端还需 API Key，
# 本地 ollama / LM Studio 可留空 Key。
# 示例：DeepSeek / 通义 / OpenAI / ollama(http://localhost:11434/v1)
AGENT_MODEL_BASE_URL=
AGENT_MODEL_ID=
AGENT_MODEL_API_KEY=

# ─── 外部服务 ───────────────────────────────────────────────────────────

# TMDB v4 只读 Token（可选）。不填走作者内置 CF Worker 代理（开箱即用）。
# ⚠️ #38 计划重构为 TMDB_API_KEY 单通道必填，届时此变量移除。
TMDB_READ_TOKEN=

# 自定义 TMDB API 代理地址（墙内用户自建代理时填）
# 优先级：设置页 DB > env > 直连 api.themoviedb.org
# TMDB_BASE_URL=

# PanSou 搜索聚合器地址。compose 自带容器注入 http://pansou。
# 优先级：设置页 DB > env > 官方公共源 https://so.252035.xyz
PANSOU_BASE_URL=https://so.252035.xyz

# PanSou 容器镜像（ghcr 不可达时用镜像站）
# PANSOU_IMAGE=ghcr.io/fish2018/pansou-web:latest

# Prowlarr 索引器（可选）
# PROWLARR_BASE_URL=
# PROWLARR_API_KEY=

# ─── 推送通知 ───────────────────────────────────────────────────────────

# 四种通道，非空即启用。优先级：设置页 > env。可同时启用多种。

# PushBark
# MEDIA_TRACK_PUSH_BARK_KEY=
# MEDIA_TRACK_PUSH_BARK_BASE_URL=

# ServerChan（Server 酱）
# MEDIA_TRACK_PUSH_SERVERCHAN_SENDKEY=

# 企业微信
# MEDIA_TRACK_PUSH_WECOM_WEBHOOK=

# 通用 Webhook
# MEDIA_TRACK_PUSH_WEBHOOK_URL=

# ─── Demo 模式 ──────────────────────────────────────────────────────────

# 服务端 Demo 只读门禁。设为 "1" 禁止所有写操作（公开演示站用）。
# MEDIA_TRACK_DEMO_MODE=

# 客户端 Demo 标志。Next.js 内联到前端 bundle，控制 UI 行为。
# 公开演示站同时设两个。
# NEXT_PUBLIC_MEDIA_TRACK_DEMO_MODE=

# ─── HTTP 代理 ──────────────────────────────────────────────────────────

# 出站代理（Node fetch 默认不读代理变量，本项目已显式支持）。
# 墙内用户自建代理时填，让 TMDB / PanSou 请求走代理穿透。
# 172.17.0.1 = Docker 默认网关（指向宿主机），端口换成你的代理端口。
# 详见 docs/deploy.md
# HTTP_PROXY=http://172.17.0.1:7890
# HTTPS_PROXY=http://172.17.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ─── Docker / 构建时变量（非运行时） ──────────────────────────────────

# Docker Hub 镜像源（墙内必读）。公共镜像站会轮流失效，一个不通就换。
# 已实测可用：docker.1ms.run / dockerproxy.net / docker.m.daocloud.io
# 留空 = 直连 Docker Hub。注意 pansou 走 ghcr.io，不受此变量影响。
# DOCKER_MIRROR=docker.1ms.run

# Web 容器映射的宿主机端口
# WEB_PORT=3000

# 构建时的 Git commit SHA（烧入镜像，部署时校验版本用）
# GIT_SHA=

# fnOS / fpk 打包变量（CI 自动设置）
# APPNAME=
# DISPLAY_NAME=
# SERVICE_PORT=

# Cloudflare API Token（部署 TMDB Proxy Worker 用）
# CLOUDFLARE_API_TOKEN=

# ═════════════════════════════════════════════════════════════════════════
